{
  "version": 8,
  "name": "OpenFreeMap Cyber Tron",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#030711"
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "match",
        ["geometry-type"],
        ["MultiPolygon", "Polygon"],
        true,
        false
      ],
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "residential",
          "#070b18",
          "commercial",
          "#12091f",
          "industrial",
          "#160726",
          "#060914"
        ],
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          7,
          0.32,
          12,
          0.8
        ]
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "filter": [
        "match",
        ["geometry-type"],
        ["MultiPolygon", "Polygon"],
        true,
        false
      ],
      "paint": {
        "fill-color": "#061a20",
        "fill-opacity": 0.72
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "minzoom": 7,
      "filter": [
        "match",
        ["geometry-type"],
        ["MultiPolygon", "Polygon"],
        true,
        false
      ],
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "wood",
          "#06211f",
          "grass",
          "#07171a",
          "#061018"
        ],
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          7,
          0.2,
          12,
          0.78
        ]
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": [
        "all",
        [
          "match",
          ["geometry-type"],
          ["MultiPolygon", "Polygon"],
          true,
          false
        ],
        ["!=", ["get", "brunnel"], "tunnel"]
      ],
      "paint": {
        "fill-color": "#061a35",
        "fill-opacity": 1
      }
    },
    {
      "id": "water-outline-glow",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": [
        "match",
        ["geometry-type"],
        ["MultiPolygon", "Polygon"],
        true,
        false
      ],
      "paint": {
        "line-color": "#00e5ff",
        "line-opacity": 0.18,
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          4,
          0.6,
          12,
          3,
          16,
          10
        ],
        "line-blur": [
          "interpolate",
          ["linear"],
          ["zoom"],
          4,
          1,
          12,
          3,
          16,
          8
        ]
      }
    },
    {
      "id": "waterway-glow",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": [
        "match",
        ["geometry-type"],
        ["LineString", "MultiLineString"],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#00e5ff",
        "line-opacity": 0.22,
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          7,
          1,
          12,
          5,
          16,
          14
        ],
        "line-blur": [
          "interpolate",
          ["linear"],
          ["zoom"],
          7,
          1,
          12,
          2,
          16,
          5
        ]
      }
    },
    {
      "id": "waterway-core",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": [
        "match",
        ["geometry-type"],
        ["LineString", "MultiLineString"],
        true,
        false
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#72f7ff",
        "line-opacity": 0.95,
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          7,
          0.4,
          12,
          1.2,
          16,
          3
        ]
      }
    },
    {
      "id": "building-fill",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 12,
      "paint": {
        "fill-color": "#08122a",
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          12,
          0.35,
          15,
          0.75
        ]
      }
    },
    {
      "id": "building-outline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "line-color": "#3ff4ff",
        "line-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          13,
          0.38,
          16,
          0.75
        ],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          13,
          0.25,
          16,
          0.9
        ]
      }
    },
    {
      "id": "roads-glow",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": [
        "all",
        [
          "match",
          ["geometry-type"],
          ["LineString", "MultiLineString"],
          true,
          false
        ],
        [
          "match",
          ["get", "class"],
          ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service", "track"],
          true,
          false
        ],
        ["!=", ["get", "brunnel"], "tunnel"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          ["get", "class"],
          "secondary",
          "#ff38d7",
          "tertiary",
          "#895cff",
          "motorway",
          "#00f5ff",
          "#00e5ff"
        ],
        "line-opacity": 0.25,
        "line-width": [
          "interpolate",
          ["exponential", 1.35],
          ["zoom"],
          5,
          2,
          12,
          8,
          18,
          30
        ],
        "line-blur": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5,
          1,
          12,
          3,
          18,
          8
        ]
      }
    },
    {
      "id": "roads-core",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": [
        "all",
        [
          "match",
          ["geometry-type"],
          ["LineString", "MultiLineString"],
          true,
          false
        ],
        [
          "match",
          ["get", "class"],
          ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service", "track"],
          true,
          false
        ],
        ["!=", ["get", "brunnel"], "tunnel"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          ["get", "class"],
          "secondary",
          "#ff62df",
          "tertiary",
          "#a98cff",
          "motorway",
          "#9dfaff",
          "trunk",
          "#6cf7ff",
          "#38ecff"
        ],
        "line-opacity": 0.92,
        "line-width": [
          "interpolate",
          ["exponential", 1.35],
          ["zoom"],
          5,
          0.6,
          12,
          2.1,
          18,
          8
        ]
      }
    },
    {
      "id": "paths",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": [
        "all",
        [
          "match",
          ["geometry-type"],
          ["LineString", "MultiLineString"],
          true,
          false
        ],
        ["==", ["get", "class"], "path"]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#4b8cff",
        "line-opacity": 0.42,
        "line-width": [
          "interpolate",
          ["exponential", 1.2],
          ["zoom"],
          13,
          0.6,
          18,
          3
        ],
        "line-dasharray": [1, 1.6]
      }
    },
    {
      "id": "railway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": [
        "all",
        [
          "match",
          ["geometry-type"],
          ["LineString", "MultiLineString"],
          true,
          false
        ],
        [
          "match",
          ["get", "class"],
          ["rail", "transit"],
          true,
          false
        ]
      ],
      "layout": {
        "line-join": "round"
      },
      "paint": {
        "line-color": "#d7a7ff",
        "line-opacity": 0.72,
        "line-width": [
          "interpolate",
          ["exponential", 1.3],
          ["zoom"],
          12,
          0.6,
          18,
          3
        ],
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": [
        "all",
        ["!=", ["get", "maritime"], 1],
        [
          "match",
          ["get", "admin_level"],
          [2, 3, 4, 5, 6],
          true,
          false
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#315dff",
        "line-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          3,
          0.25,
          8,
          0.55,
          12,
          0.35
        ],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          3,
          0.5,
          8,
          1.2,
          12,
          2.4
        ],
        "line-dasharray": [1.5, 1.5]
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "filter": [
        "all",
        [
          "match",
          ["geometry-type"],
          ["LineString", "MultiLineString"],
          true,
          false
        ],
        [
          "match",
          ["get", "class"],
          ["primary", "secondary", "tertiary", "trunk", "motorway", "minor", "service", "track"],
          true,
          false
        ]
      ],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 420,
        "text-field": [
          "case",
          ["has", "name:nonlatin"],
          ["concat", ["get", "name:latin"], " ", ["get", "name:nonlatin"]],
          ["coalesce", ["get", "name_en"], ["get", "name"]]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-rotation-alignment": "map",
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          12,
          10,
          16,
          14
        ]
      },
      "paint": {
        "text-color": "#d8fdff",
        "text-halo-color": "#020510",
        "text-halo-width": 1.4,
        "text-halo-blur": 0.3
      }
    },
    {
      "id": "water-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "filter": [
        "match",
        ["geometry-type"],
        ["Point", "MultiPoint"],
        true,
        false
      ],
      "layout": {
        "text-field": [
          "case",
          ["has", "name:nonlatin"],
          ["concat", ["get", "name:latin"], "\n", ["get", "name:nonlatin"]],
          ["coalesce", ["get", "name_en"], ["get", "name"]]
        ],
        "text-font": ["Noto Sans Italic"],
        "text-letter-spacing": 0.15,
        "text-max-width": 6,
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          0,
          10,
          8,
          14,
          14,
          16
        ]
      },
      "paint": {
        "text-color": "#7cefff",
        "text-halo-color": "#03101f",
        "text-halo-width": 1.2,
        "text-opacity": 0.85
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": [
        "match",
        ["get", "class"],
        ["city", "town", "village", "state", "country"],
        true,
        false
      ],
      "layout": {
        "text-field": [
          "case",
          ["has", "name:nonlatin"],
          ["concat", ["get", "name:latin"], "\n", ["get", "name:nonlatin"]],
          ["coalesce", ["get", "name_en"], ["get", "name"]]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-max-width": 8,
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          3,
          10,
          7,
          14,
          11,
          20
        ]
      },
      "paint": {
        "text-color": "#f4feff",
        "text-halo-color": "#020510",
        "text-halo-width": 2,
        "text-halo-blur": 0.8
      }
    }
  ]
}
